{
  "name": "restaurant-demo",
  "private": true,
  "workspaces": [
    "shared",
    "api",
    "admin",
    "sites"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck -w api && tsc -p admin --noEmit",
    "build": "npm run build -w admin",
    "deploy": "npm run build -w admin && npm run deploy -w api",
    "shots": "node scripts/site-shots.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
