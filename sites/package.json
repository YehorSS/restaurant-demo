{
  "name": "sites",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:lucciola": "vite --config lucciola/vite.config.ts",
    "build:lucciola": "vite build --config lucciola/vite.config.ts",
    "preview:lucciola": "vite preview --config lucciola/vite.config.ts",
    "build": "tsc --noEmit && npm run build:lucciola && npm run build:zhar && npm run build:landing",
    "test": "vitest run",
    "dev:zhar": "vite --config zhar/vite.config.ts",
    "build:zhar": "vite build --config zhar/vite.config.ts",
    "preview:zhar": "vite preview --config zhar/vite.config.ts",
    "build:landing": "node -e \"require('fs').copyFileSync('landing.html','dist-pages/restaurant-demo/index.html')\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^25.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "4.1"
  }
}
